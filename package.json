{
  "name": "banqueunt-mcp",
  "version": "0.1.0",
  "description": "MCP server that exposes the BanqueUNT medical question bank to AI assistants",
  "type": "module",
  "bin": {
    "banqueunt-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data/muestra.json"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "muestra": "tsx scripts/crear-muestra.ts",
    "uso": "tsx scripts/uso.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
